{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "SurrealQL",
	"scopeName": "source.surrealql",
	"fileTypes": [
		".surql",
		".surrealql"
	],
	"foldingStartMarker": "[\\{|\\[|\\(]\\s*$",
	"foldingStopMarker": "^\\s*[\\}|\\]\\)]",
	"patterns": [
		{
			"include": "#comment"
		},
		{
			"include": "#define-type"
		},
		{
			"include": "#type-clause"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#version"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#js-function"
		},
		{
			"include": "#function"
		},
		{
			"include": "#value"
		}
	],
	"repository": {
		"comment.line.dash": {
			"begin": "--",
			"end": "\\n",
			"name": "comment.line.double-dash"
		},
		"comment.line.slash": {
			"begin": "//",
			"end": "\\n",
			"name": "comment.line.double-slash"
		},
		"comment.line.hash": {
			"begin": "#",
			"end": "\\n",
			"name": "comment.line.number-sign"
		},
		"comment.block": {
			"begin": "/\\*",
			"end": "\\*/",
			"name": "comment.block.surrealql"
		},
		"comment": {
			"patterns": [
				{
					"include": "#comment.line.dash"
				},
				{
					"include": "#comment.line.slash"
				},
				{
					"include": "#comment.line.hash"
				},
				{
					"include": "#comment.block"
				}
			]
		},
		"define-type": {
			"begin": "(?i)\\b(DEFINE|ALTER)\\s+(TYPE)\\s+(?:(IF\\s+NOT\\s+EXISTS|IF\\s+EXISTS|OVERWRITE)\\s+)?(\\w+)\\s+(AS)\\b",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.surrealql"
				},
				"2": {
					"name": "keyword.control.surrealql"
				},
				"3": {
					"name": "keyword.control.surrealql"
				},
				"4": {
					"name": "entity.name.type.surrealql"
				},
				"5": {
					"name": "keyword.control.surrealql"
				}
			},
			"end": "(?=(?i)\\b(DEFAULT|ASSERT|VALUE|COMMENT|PERMISSIONS|REFERENCE|READONLY|FLEXIBLE|COMPUTED|INLINE|MATERIALIZE|MIGRATE|SQL|GRAPHQL_ALIAS|GRAPHQL_DEPRECATED|CONSTRAINT|IN|OUT|FROM|TO|ENFORCED|LIGHTWEIGHT|SCHEMAFULL|SCHEMAFUL|SCHEMALESS|CHANGEFEED|DROP|AS|DIST|DISTANCE|DIMENSION|EFC|M|LM|M0|CAPACITY|EXTEND_CANDIDATES|KEEP_PRUNED_CONNECTIONS|HASHED_VECTOR|DEGREE|L_BUILD|ALPHA|SIGNUP|SIGNIN|WITH|ALGORITHM|URL|KEY|FOR|AUTHENTICATE|DURATION|IF|ADD|RENAME|PREPARE)\\b|;|$)",
			"name": "meta.type.annotation.surrealql",
			"patterns": [
				{
					"include": "#type-content"
				}
			]
		},
		"type-clause": {
			"begin": "(?i)\\b(TYPE)\\b",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.surrealql"
				}
			},
			"end": "(?=(?i)\\b(DEFAULT|ASSERT|VALUE|COMMENT|PERMISSIONS|REFERENCE|READONLY|FLEXIBLE|COMPUTED|INLINE|MATERIALIZE|MIGRATE|SQL|GRAPHQL_ALIAS|GRAPHQL_DEPRECATED|CONSTRAINT|IN|OUT|FROM|TO|ENFORCED|LIGHTWEIGHT|SCHEMAFULL|SCHEMAFUL|SCHEMALESS|CHANGEFEED|DROP|AS|DIST|DISTANCE|DIMENSION|EFC|M|LM|M0|CAPACITY|EXTEND_CANDIDATES|KEEP_PRUNED_CONNECTIONS|HASHED_VECTOR|DEGREE|L_BUILD|ALPHA|SIGNUP|SIGNIN|WITH|ALGORITHM|URL|KEY|FOR|AUTHENTICATE|DURATION|IF|ADD|RENAME|PREPARE)\\b|;|$)",
			"name": "meta.type.annotation.surrealql",
			"patterns": [
				{
					"include": "#type-content"
				}
			]
		},
		"type-content": {
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"include": "#string"
				},
				{
					"include": "#number"
				},
				{
					"include": "#void-type"
				},
				{
					"name": "keyword.operator.union.surrealql",
					"match": "\\|"
				},
				{
					"name": "punctuation.definition.type.surrealql",
					"match": "[\\[\\]<>]"
				},
				{
					"name": "punctuation.separator.type.surrealql",
					"match": ","
				},
				{
					"include": "#index-type"
				},
				{
					"name": "entity.name.type.surrealql",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
				}
			]
		},
		"type": {
			"match": "[a-z]*<[a-zA-Z][a-zA-Z0-9<>|, _]+[a-zA-Z0-9>]+>",
			"name": "meta.type.annotation.surrealql",
			"captures": {
				"0": {
					"patterns": [
						{
							"match": "<|>",
							"name": "entity.name.type.surrealql"
						},
						{
							"include": "#number"
						},
						{
							"include": "#void-type"
						}
					]
				}
			}
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control keyword.control.surrealql",
					"match": "(?i)\\b(keep_pruned_connections|graphql_deprecated|doc_lengths_cache|doc_lengths_order|extend_candidates|postings_cache|postings_order|compatibility|doc_ids_cache|doc_ids_order|graphql_alias|hashed_vector|introspection|query_timeout|authenticate|capabilities|concurrently|lightweight|materialize|mtree_cache|permissions|terms_cache|terms_order|transaction|changefeed|complexity|constraint|descending|highlights|middleware|references|schemafull|schemaless|signatures|tokenizers)\\b"
				},
				{
					"name": "keyword.control keyword.control.surrealql",
					"match": "(?i)\\b(undeclared|withaccess|algorithm|ascending|dimension|duplicate|extension|functions|isolation|namespace|overwrite|passscram|reference|schemaful|staleness|structure|tempfiles|analyzer|audience|bindings|capacity|computed|continue|database|distance|distinct|duration|enforced|existing|fallback|flexible|fulltext|function|maxdepth|original)\\b"
				},
				{
					"name": "keyword.control keyword.control.surrealql",
					"match": "(?i)\\b(parallel|passhash|password|readonly|relation|security|sequence|unsigned|analyze|backend|cascade|changes|collate|columns|comment|compact|content|context|default|definer|diskann|exclude|expired|explain|expunge|filters|graphql|include|invoker|l_build|migrate|noindex|numeric|prepare|rebuild)\\b"
				},
				{
					"name": "keyword.control keyword.control.surrealql",
					"match": "(?i)\\b(refresh|replace|revoked|session|spatial|timeout|version|access|always|assert|bearer|bucket|cancel|commit|config|create|define|degree|delete|digest|exists|fields|format|ignore|inline|insert|issuer|module|normal|option|record|reject|relate|remove|rename)\\b"
				},
				{
					"name": "keyword.control keyword.control.surrealql",
					"match": "(?i)\\b(return|revoke|search|select|signer|signin|signup|strict|system|tables|unique|update|upsert|values|alpha|alter|async|batch|begin|break|defer|depth|edges|event|fetch|field|grant|group|index|level|limit|merge|mtree|nulls|order)\\b"
				},
				{
					"name": "keyword.control keyword.control.surrealql",
					"match": "(?i)\\b(param|patch|purge|retry|roles|scope|since|sleep|split|start|table|throw|token|trace|unset|using|value|where|auto|bm25|desc|dist|drop|else|from|hnsw|info|into|kill|live|omit|only|read|root|rows)\\b"
				},
				{
					"name": "keyword.control keyword.control.surrealql",
					"match": "(?i)\\b(show|then|type|user|when|with|add|all|any|api|asc|efc|end|for|get|jwt|key|let|max|not|out|put|set|sql|url|use|as|at|by|db|if|in|kv|lm|m0)\\b"
				},
				{
					"name": "keyword.control keyword.control.surrealql",
					"match": "(?i)\\b(no|ns|on|sc|tb|to|m)\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.arrow.surrealql",
					"match": "<->|->|<-|<~"
				},
				{
					"include": "#regex-literal"
				},
				{
					"name": "keyword.operator.flatten.surrealql",
					"match": "\\.\\.\\.|…"
				},
				{
					"name": "keyword.operator.range.surrealql",
					"match": "\\.\\.(?=\\=)"
				},
				{
					"name": "keyword.operator.range.surrealql",
					"match": "\\.\\.(?!\\.)"
				},
				{
					"name": "keyword.operator.word.surrealql",
					"match": "(?i)\\b(containsnone|containsnot|containsall|containsany|noneinside|intersects|notinside|allinside|anyinside|contains|outside|inside|and|or)\\b"
				},
				{
					"name": "keyword.operator.logical-and.surrealql",
					"match": "&&"
				},
				{
					"name": "keyword.operator.logical-or.surrealql",
					"match": "\\|\\|"
				},
				{
					"name": "keyword.operator.assignment.surrealql",
					"match": "\\+\\?=|\\+=|-="
				},
				{
					"name": "keyword.operator.is-not.surrealql",
					"match": "\\b(IS NOT|is not)\\b|!="
				},
				{
					"name": "keyword.operator.is.surrealql",
					"match": "\\b(IS|is)\\b|="
				},
				{
					"name": "keyword.operator.containssome.surrealql",
					"match": "\\b(CONTAINSSOME|containssome)\\b"
				},
				{
					"name": "keyword.operator.contains.surrealql",
					"match": "∋"
				},
				{
					"name": "keyword.operator.containsall.surrealql",
					"match": "⊇"
				},
				{
					"name": "keyword.operator.containsany.surrealql",
					"match": "⊃"
				},
				{
					"name": "keyword.operator.containsnone.surrealql",
					"match": "⊅"
				},
				{
					"name": "keyword.operator.containsnot.surrealql",
					"match": "∌"
				},
				{
					"name": "keyword.operator.allinside.surrealql",
					"match": "⊆"
				},
				{
					"name": "keyword.operator.anyinside.surrealql",
					"match": "⊂"
				},
				{
					"name": "keyword.operator.noneinside.surrealql",
					"match": "⊄"
				},
				{
					"name": "keyword.operator.notinside.surrealql",
					"match": "∉"
				},
				{
					"name": "keyword.operator.inside.surrealql",
					"match": "∈"
				},
				{
					"name": "keyword.operator.equal.surrealql",
					"match": "=="
				},
				{
					"name": "keyword.operator.all-equal.surrealql",
					"match": "\\*="
				},
				{
					"name": "keyword.operator.any-equal.surrealql",
					"match": "\\?="
				},
				{
					"name": "keyword.operator.logical-not.surrealql",
					"match": "!(?![=~])"
				},
				{
					"name": "keyword.operator.fuzzy-inequal.surrealql",
					"match": "!~"
				},
				{
					"name": "keyword.operator.fuzzy-all-equal.surrealql",
					"match": "\\*~"
				},
				{
					"name": "keyword.operator.fuzzy-any-equal.surrealql",
					"match": "\\?~"
				},
				{
					"name": "keyword.operator.fuzzy-equal.surrealql",
					"match": "~"
				},
				{
					"name": "keyword.operator.less-or-equal.surrealql",
					"match": "<="
				},
				{
					"name": "keyword.operator.less.surrealql",
					"match": "<(?!-|[a-z]+[^:])"
				},
				{
					"name": "keyword.operator.more-or-equal.surrealql",
					"match": ">="
				},
				{
					"name": "keyword.operator.more.surrealql",
					"match": "(?<!-)>"
				},
				{
					"name": "keyword.operator.add.surrealql",
					"match": "\\+"
				},
				{
					"name": "keyword.operator.subtract.surrealql",
					"match": "-"
				},
				{
					"name": "keyword.operator.multiply.surrealql",
					"match": "\\*|×|∙"
				},
				{
					"name": "keyword.operator.devide.surrealql",
					"match": "\\/|÷"
				},
				{
					"name": "keyword.operator.modulo.surrealql",
					"match": "%"
				},
				{
					"name": "keyword.operator.matches.surrealql",
					"match": "@(?:([0-9]+)(?:,((?i:and|or)))?|((?i:and|or)))?@",
					"captures": {
						"1": {
							"name": "constant.numeric.int"
						},
						"2": {
							"name": "keyword.operator.word.surrealql"
						},
						"3": {
							"name": "keyword.operator.word.surrealql"
						}
					}
				},
				{
					"name": "keyword.operator.optional.surrealql",
					"match": "\\.\\?"
				},
				{
					"name": "keyword.operator.either.surrealql",
					"match": "\\?:"
				},
				{
					"name": "keyword.operator.truthy.surrealql",
					"match": "\\?\\?"
				},
				{
					"name": "keyword.operator.knn.surrealql",
					"match": "\\<\\|([a-zA-Z|\\d|,])+\\|\\>"
				}
			]
		},
		"js-function": {
			"begin": "(?=(\\bfunction\\b))",
			"end": "(?<=})",
			"beginCaptures": {
				"1": {
					"name": "support.function.js"
				}
			},
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"begin": "\\(",
					"end": "\\)",
					"name": "meta.function.arguments",
					"patterns": [
						{
							"include": "#value"
						}
					]
				},
				{
					"begin": "{",
					"end": "}",
					"name": "meta.embedded.block.javascript",
					"patterns": [
						{
							"include": "source.js"
						}
					]
				}
			]
		},
		"function": {
			"begin": "\\b(\\w+(?:::\\w+)+|count|rand|\\w+(?=<\\d+(?:_\\d+)*(?:\\.\\d+(?:_\\d+)*){0,2}>::))(<\\d+(?:_\\d+)*(?:\\.\\d+(?:_\\d+)*){0,2}>)?(?:(::)(\\w+))?(?=\\s*\\()",
			"end": "(?<=\\))",
			"beginCaptures": {
				"1": {
					"name": "support.function"
				},
				"2": {
					"name": "constant.numeric.version.surrealql"
				},
				"3": {
					"name": "support.function"
				},
				"4": {
					"name": "support.function"
				}
			},
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"begin": "\\(",
					"end": "\\)",
					"name": "meta.function.arguments",
					"patterns": [
						{
							"include": "#value"
						}
					]
				}
			]
		},
		"function-name": {
			"match": "\\b[a-zA-Z_]\\w*(?:::\\w+)+\\b(?!\\s*\\()",
			"name": "support.function"
		},
		"version": {
			"match": "(?<=\\w)<\\d+(?:_\\d+)*(?:\\.\\d+(?:_\\d+)*){0,2}>",
			"name": "constant.numeric.version.surrealql"
		},
		"var-name": {
			"patterns": [
				{
					"match": "\\$\\w+",
					"name": "variable.name"
				},
				{
					"match": "\\$`\\w+`",
					"name": "variable.name"
				},
				{
					"match": "\\$⟨\\w+⟩",
					"name": "variable.name"
				}
			]
		},
		"number": {
			"patterns": [
				{
					"match": "\\b\\d+(?:_\\d+)*(?:\\.\\d+(?:_\\d+)*)?(?:[eE][+-]?\\d+(?:_\\d+)*)?(?:bigdec|dec)\\b",
					"name": "constant.numeric.decimal"
				},
				{
					"match": "\\b(?:\\d+(?:_\\d+)*f(?:16|32|64)?|\\d+(?:_\\d+)*(?:\\.\\d+(?:_\\d+)*(?:[eE][+-]?\\d+(?:_\\d+)*)?|[eE][+-]?\\d+(?:_\\d+)*)(?:f(?:16|32|64)?)?)\\b",
					"name": "constant.numeric.decimal"
				},
				{
					"match": "\\b\\d+(?:_\\d+)*(?:[iu](?:8|16|32|64))?\\b",
					"name": "constant.numeric.int"
				}
			]
		},
		"string": {
			"patterns": [
				{
					"begin": "(?:\\b(?:ivl|pd|pt|ts)|[a-z])?\"",
					"end": "(?<!\\\\)\"",
					"name": "string.quoted.double"
				},
				{
					"begin": "(?:\\b(?:ivl|pd|pt|ts)|[a-z])?'",
					"end": "(?<!\\\\)'",
					"name": "string.quoted.single"
				}
			]
		},
		"ident": {
			"patterns": [
				{
					"begin": "`",
					"end": "(?<!\\\\)`",
					"name": "support.type.property-name"
				},
				{
					"begin": "⟨",
					"end": "(?<!\\\\)⟩",
					"name": "support.type.property-name"
				}
			]
		},
		"duration": {
			"match": "(\\d+(?:_\\d+)* *(?:ns|µs|ms|s|m|h|d|w|y)(?![A-Za-z_]))+",
			"name": "constant.other"
		},
		"boolean": {
			"match": "\\b(true|TRUE|false|FALSE|True|False)\\b",
			"name": "constant.language.bool"
		},
		"void-type": {
			"match": "\\b(null|NULL|none|NONE)\\b",
			"name": "constant.language.void"
		},
		"positional": {
			"match": "\\b(AFTER|after|BEFORE|before)\\b",
			"name": "constant.language.positional"
		},
		"array": {
			"begin": "\\[",
			"end": "\\]",
			"patterns": [
				{
					"include": "#array-content"
				}
			]
		},
		"array-content": {
			"patterns": [
				{
					"include": "$self"
				},
				{
					"match": ",",
					"name": "punctuation.separator.array"
				}
			]
		},
		"block": {
			"begin": "\\{",
			"end": "\\}",
			"name": "surrealql.block",
			"patterns": [
				{
					"include": "#block-content"
				}
			]
		},
		"block-content": {
			"patterns": [
				{
					"include": "#string"
				},
				{
					"include": "#object-key"
				},
				{
					"include": "$self"
				}
			]
		},
		"object-key": {
			"patterns": [
				{
					"match": "(?:^|{|,)[ \t]*(\"[^(?:\\\")]+\")(?=:(?!:))",
					"captures": {
						"1": {
							"name": "string.quoted.double"
						}
					}
				},
				{
					"match": "(?:^|{|,)[ \t]*('[^(?:\\')]+')(?=:(?!:))",
					"captures": {
						"1": {
							"name": "string.quoted.single"
						}
					}
				},
				{
					"match": "(^|\\{|\\,)[ \t]*([a-zA-Z_0-9]+)(?=:(?!:))",
					"captures": {
						"2": {
							"name": "meta.object-literal.key"
						}
					}
				}
			]
		},
		"record": {
			"patterns": [
				{
					"match": "(\\b\\w+\\b):⟨([^⟩]+)⟩",
					"captures": {
						"1": {
							"name": "entity.name.class"
						},
						"2": {
							"name": "entity.name.class"
						}
					}
				},
				{
					"match": "(\\b\\w+\\b):`([^`]+)`",
					"captures": {
						"1": {
							"name": "entity.name.class"
						},
						"2": {
							"name": "entity.name.class"
						}
					}
				},
				{
					"begin": "(\\b\\w+\\b):(?=(\\b[\\w:]+\\b)\\s*\\()",
					"end": "(?<=\\))",
					"beginCaptures": {
						"1": {
							"name": "entity.name.class"
						},
						"2": {
							"name": "support.function"
						}
					},
					"patterns": [
						{
							"include": "#comment"
						},
						{
							"begin": "\\(",
							"end": "\\)",
							"name": "meta.function.arguments",
							"patterns": [
								{
									"include": "#value"
								}
							]
						}
					]
				},
				{
					"match": "(\\b\\w+\\b):(\\b\\w+\\b)",
					"captures": {
						"1": {
							"name": "entity.name.class"
						},
						"2": {
							"name": "entity.name.class"
						}
					}
				},
				{
					"begin": "(\\b\\w+\\b):\\[",
					"end": "\\]",
					"captures": {
						"1": {
							"name": "entity.name.class"
						}
					},
					"patterns": [
						{
							"include": "#array-content"
						}
					]
				},
				{
					"begin": "(\\b\\w+\\b):(?=\\{)",
					"end": "\\}",
					"captures": {
						"1": {
							"name": "entity.name.class"
						}
					},
					"patterns": [
						{
							"include": "#block-content"
						}
					]
				}
			]
		},
		"query": {
			"patterns": [
				{
					"include": "$self"
				}
			]
		},
		"subquery": {
			"begin": "\\(",
			"end": "\\)",
			"patterns": [
				{
					"include": "#query"
				},
				{
					"include": "#value"
				}
			]
		},
		"value": {
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"include": "#js-function"
				},
				{
					"include": "#function"
				},
				{
					"include": "#function-name"
				},
				{
					"include": "#block"
				},
				{
					"include": "#array"
				},
				{
					"include": "#var-name"
				},
				{
					"include": "#boolean"
				},
				{
					"include": "#string"
				},
				{
					"include": "#ident"
				},
				{
					"include": "#void-type"
				},
				{
					"include": "#positional"
				},
				{
					"include": "#duration"
				},
				{
					"include": "#number"
				},
				{
					"include": "#record"
				},
				{
					"include": "#subquery"
				},
				{
					"include": "#version"
				},
				{
					"include": "#type"
				},
				{
					"include": "#index-type"
				},
				{
					"include": "#token-type"
				},
				{
					"include": "#distance-name"
				},
				{
					"include": "#filter-name"
				},
				{
					"include": "#analyzer-tokenizer"
				},
				{
					"include": "#literal-keyword"
				},
				{
					"include": "#regex-literal"
				},
				{
					"include": "#identifier"
				}
			]
		},
		"index-type": {
			"match": "(?i)\\b(f16|f32|f64|i8|i16|i32|i64|u8)\\b",
			"name": "constant.language.index-type.surrealql"
		},
		"token-type": {
			"match": "(?i)\\b(eddsa|es256|es384|es512|hs256|hs384|hs512|ps256|ps384|ps512|rs256|rs384|rs512|jwks)\\b",
			"name": "support.constant.token-type.surrealql"
		},
		"distance-name": {
			"match": "(?i)\\b(cosine_normalized|inner_product|chebyshev|euclidean|manhattan|minkowski|hamming|jaccard|pearson|cosine)\\b",
			"name": "support.constant.distance.surrealql"
		},
		"filter-name": {
			"match": "(?i)\\b(edgengram|lowercase|uppercase|snowball|mapper|ascii|ngram)\\b",
			"name": "support.constant.filter.surrealql"
		},
		"analyzer-tokenizer": {
			"match": "(?i)\\b(segment|blank|camel|class|punct)\\b",
			"name": "support.constant.analyzer-tokenizer.surrealql"
		},
		"literal-keyword": {
			"match": "(?i)\\b(diff|full)\\b",
			"name": "constant.language.literal.surrealql"
		},
		"identifier": {
			"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
			"name": "variable.other.surrealql"
		},
		"regex-literal": {
			"name": "string.regexp.surrealql",
			"match": "(?<![A-Za-z0-9])(\\/)(?:[^\\\\/]|\\\\.|\\[(?:[^\\]\\\\]|\\\\.)*\\])*(\\/)([a-z]*)"
		}
	}
}
